# Environment Configuration
COMMERCE_AI_ENV=development
COMMERCE_AI_DEBUG=true

# Data Paths
COMMERCE_AI_DATA_DIR=data
COMMERCE_AI_RAW_DIR=data/raw
COMMERCE_AI_PROCESSED_DIR=data/processed
COMMERCE_AI_SAMPLE_DIR=data/sample

# Generator Defaults
COMMERCE_AI_GEN_SKUS=500
COMMERCE_AI_GEN_WAREHOUSES=5
COMMERCE_AI_GEN_CHANNELS=4
COMMERCE_AI_GEN_SUPPLIERS=20
COMMERCE_AI_GEN_HISTORICAL_DAYS=730
COMMERCE_AI_GEN_SEED=42

# API Server (Future)
COMMERCE_AI_API_HOST=0.0.0.0
COMMERCE_AI_API_PORT=8000
